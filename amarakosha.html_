<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vedic Space | Amarakosha </title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet">

<style>
:root{
  --blue:#1e3a8a;
  --gold:#fbbf24;
  --bg:#0f172a;
  --card:rgba(255,255,255,0.06);
  --border:rgba(251,191,36,0.25);
  --text:#f8fafc;
  --muted:#cbd5e1;
  --radius:18px;
  --sidebar:300px;
}

*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Inter,sans-serif;
  background:linear-gradient(135deg,#1e3a8a,#0f172a);
  color:var(--text);
  min-height:100vh;
}

.app{display:flex}

/* Sidebar */
.sidebar{
  width:var(--sidebar);
  position:fixed;
  inset:0 auto 0 0;
  background:rgba(30,58,138,0.96);
  border-right:1px solid var(--border);
  padding:1.5rem;
  display:flex;
  flex-direction:column;
  gap:1.25rem;
}

.logo{
  font-family:Playfair Display,serif;
  font-size:1.4rem;
  font-weight:600;
}

.sidebar h1{
  font-family:Playfair Display,serif;
  font-weight:400;
  line-height:1.2;
}

.sidebar h1 span{color:var(--gold)}

.search input{
  width:100%;
  padding:0.85rem 1.1rem;
  border-radius:30px;
  border:2px solid var(--border);
  background:rgba(255,255,255,0.1);
  color:white;
  font-size:1rem;
}

.search input:focus{
  outline:none;
  border-color:var(--gold);
}

.toggle{
  display:flex;
  gap:0.5rem;
}

.toggle button{
  flex:1;
  padding:0.45rem 0;
  border-radius:20px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--muted);
  cursor:pointer;
  font-size:0.8rem;
}

.toggle button.active{
  background:var(--gold);
  color:#1e3a8a;
  font-weight:600;
}

.count{
  font-size:0.85rem;
  color:var(--muted);
}

/* Main */
main{
  margin-left:var(--sidebar);
  padding:3rem;
  width:100%;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(360px,1fr));
  gap:1.5rem;
}

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:1.8rem;
}

.badge{
  display:inline-block;
  background:linear-gradient(135deg,#fbbf24,#f59e0b);
  color:#1e3a8a;
  font-size:0.65rem;
  font-weight:700;
  padding:0.3rem 0.8rem;
  border-radius:20px;
  margin-bottom:0.8rem;
  text-transform:uppercase;
  letter-spacing:0.08em;
}

.word{
  font-family:Playfair Display,serif;
  font-size:1.7rem;
  margin-bottom:0.35rem;
}

.translit{
  font-style:italic;
  color:var(--muted);
  margin-bottom:0.5rem;
}

.meta{
  font-size:0.75rem;
  color:var(--muted);
  margin-bottom:0.5rem;
}

.meaning{
  line-height:1.6;
}

.empty, .loading{
  grid-column:1/-1;
  text-align:center;
  padding:5rem 2rem;
  color:var(--muted);
}

@media(max-width:900px){
  .sidebar{display:none}
  main{margin:0;padding:2rem 1.25rem}
}
</style>
</head>

<body>

<div class="app">

  <aside class="sidebar">
    <div class="logo">Vedic Space</div>

    <h1><span>Sanskrit</span><br>Dictionary</h1>

    <div class="search">
      <input id="search" placeholder="Enter Sanskrit word…" autocomplete="off">
    </div>

    <div class="toggle">
      <button data-script="dv" class="active">DV</button>
      <button data-script="ia">IAST</button>
      <button data-script="hk">HK</button>
    </div>

    <div class="count">
      Results: <strong id="count">0</strong>
    </div>
  </aside>

  <main>
    <div class="cards" id="cards">
      <div class="empty">Enter a Sanskrit word to begin</div>
    </div>
  </main>

</div>

<script>
const API = "https://vedicspace-skt-dict.shenoypradeep.workers.dev";

const cards = document.getElementById("cards");
const search = document.getElementById("search");
const count = document.getElementById("count");
const toggles = document.querySelectorAll(".toggle button");

let currentScript = "dv";
let debounce = null;

toggles.forEach(btn=>{
  btn.onclick = ()=>{
    toggles.forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    currentScript = btn.dataset.script;
    if(search.value.trim()) lookup(search.value.trim());
  };
});

async function lookup(word){
  cards.innerHTML = `<div class="loading">Searching…</div>`;
  count.textContent = "…";

  try{
    const url = `${API}?search=${encodeURIComponent(word)}&dir=au`;
    const res = await fetch(url);
    const data = await res.json();
    render(data.results || []);
  }catch{
    cards.innerHTML = `<div class="empty">Unable to fetch results</div>`;
    count.textContent = 0;
  }
}

function render(results){
  cards.innerHTML = "";
  count.textContent = results.length;

  if(!results.length){
    cards.innerHTML = `<div class="empty">No results found</div>`;
    return;
  }

  results.forEach(r=>{
    const word =
      currentScript === "dv" ? r.dv :
      currentScript === "ia" ? r.ia :
      r.sk;

    const el = document.createElement("div");
    el.className = "card";
    el.innerHTML = `
      <span class="badge">${r.grammar || "entry"}</span>
      <div class="word">${word || ""}</div>
      <div class="translit">${r.ia || ""}</div>
      <div class="meta">${r.source || ""}</div>
      <div class="meaning">${r.en || ""}</div>
    `;
    cards.appendChild(el);
  });
}

search.addEventListener("input", e=>{
  clearTimeout(debounce);
  const q = e.target.value.trim();
  if(!q){
    cards.innerHTML = `<div class="empty">Enter a Sanskrit word to begin</div>`;
    count.textContent = 0;
    return;
  }
  debounce = setTimeout(()=>lookup(q), 500);
});
</script>

</body>
</html>
